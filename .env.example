# Copy this file to .env and replace placeholders locally.
ADP_APP_KEY=your_published_adp_app_key
NODE_ENV=development
ADP_PORT=8787

# Render sets PORT automatically. Do not add a local PORT unless you intend to
# override ADP_PORT; the server always gives PORT precedence.

# Optional shared password for the public hackathon demo. Use only over HTTPS.
# Leave empty to disable locally; use a long random value when deployed.
ADP_DEMO_PASSWORD=

# In-memory, single-instance safeguards.
ADP_RATE_LIMIT_PER_HOUR=5
ADP_MAX_CONCURRENT=2
ADP_DAILY_REQUEST_LIMIT=50

# Keep false on Render: a caller-supplied X-Forwarded-For chain can be spoofed.
# With false, requests are keyed to the direct socket (usually Render's proxy),
# which is conservative but may cause different visitors to share one limit.
ADP_TRUST_PROXY=false
